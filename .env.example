# Supabase project root URL (do not add /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only OTP signing secret (generate 32+ random bytes)
OTP_PEPPER=replace-with-a-random-secret-at-least-32-characters

# Gmail SMTP (use a Google App Password, not your regular password)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Put your original, unmodified QR image files here before testing or deploying:
# public/images/gcash.png
# public/images/maya.png
